{
  "name": "@strk20-workbench/react",
  "version": "0.1.0",
  "description": "Reusable React components for understandable STRK20 privacy flows.",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "sideEffects": [
    "./src/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/react/tests"
  },
  "dependencies": {
    "@strk20-workbench/lab-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
