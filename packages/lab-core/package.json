{
  "name": "@strk20-workbench/lab-core",
  "version": "0.1.0",
  "description": "Framework-neutral scenario core for STRK20 Workbench.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
