{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STRK20 Workbench compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "checked_at",
    "runtime",
    "frontend",
    "packages",
    "strk20",
    "verification",
    "warnings"
  ],
  "properties": {
    "status": { "enum": ["candidate", "verified", "blocked"] },
    "checked_at": { "type": "string", "format": "date" },
    "runtime": {
      "type": "object",
      "required": ["node", "pnpm"],
      "properties": {
        "node": { "type": "string" },
        "pnpm": { "type": "string" }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["next", "react", "bundler"],
      "properties": {
        "next": { "type": "string" },
        "react": { "type": "string" },
        "bundler": { "enum": ["webpack", "turbopack"] }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starknet",
        "get_starknet_discovery",
        "get_starknet_wallet_standard",
        "types_js"
      ],
      "properties": {
        "starknet": { "type": "string" },
        "get_starknet_discovery": { "type": "string" },
        "get_starknet_wallet_standard": { "type": "string" },
        "types_js": { "type": "string" }
      }
    },
    "strk20": {
      "type": "object",
      "required": [
        "route",
        "minimum_wallet_api",
        "supported_wallet",
        "network",
        "pool_address"
      ],
      "properties": {
        "route": { "enum": ["wallet-api", "privacy-sdk"] },
        "minimum_wallet_api": { "type": "string" },
        "supported_wallet": { "type": ["string", "null"] },
        "network": { "type": "string" },
        "pool_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starter_matrix", "candidate_matrix", "browser_wallet"],
      "properties": {
        "starter_matrix": { "enum": ["passed", "failed", "pending"] },
        "candidate_matrix": { "enum": ["passed", "failed", "pending"] },
        "browser_wallet": { "enum": ["passed", "failed", "pending"] }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
